<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="FileBox.App.Views.InboxPaneView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:services="using:FileBox.App.Services"
    xmlns:views="using:FileBox.App.Views">

    <UserControl.Resources>
        <Style x:Key="InboxItem" TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
            <Setter Property="MinHeight" Value="56" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
    </UserControl.Resources>

    <Grid RowDefinitions="Auto,*">
        <Grid Padding="12,8" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8"
              BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
            <FontIcon Glyph="&#xE896;" FontSize="16" />
            <StackPanel Grid.Column="1">
                <TextBlock Text="受け取りボックス" FontWeight="SemiBold" />
                <TextBlock Text="{x:Bind ViewModel.Summary, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6">
                <Button Click="MoveAll_Click" ToolTipService.ToolTip="確信度「高」とルール一致の項目を推奨先へまとめて移動">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE8DE;" FontSize="14" />
                        <TextBlock Text="まとめて振り分け" />
                    </StackPanel>
                </Button>
                <Button Click="Settings_Click" ToolTipService.ToolTip="監視フォルダと振り分けルール">
                    <FontIcon Glyph="&#xE713;" FontSize="14" />
                </Button>
            </StackPanel>
        </Grid>

        <ListView x:Name="List" Grid.Row="1"
                  ItemsSource="{x:Bind ViewModel.Items}"
                  SelectionMode="Single"
                  ItemContainerStyle="{StaticResource InboxItem}"
                  DoubleTapped="List_DoubleTapped"
                  SelectionChanged="List_SelectionChanged">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="services:InboxItem">
                    <Grid ColumnDefinitions="28,*,Auto" ColumnSpacing="8">
                        <FontIcon Glyph="{x:Bind Glyph}" FontSize="18" HorizontalAlignment="Left" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                            <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{x:Bind Detail}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,2,0,0">
                                <Border CornerRadius="4" Padding="5,0" VerticalAlignment="Center"
                                        Background="{x:Bind views:InboxPaneView.BadgeBrush(Confidence, HasTarget), Mode=OneWay}"
                                        Visibility="{x:Bind views:Converters.Visible(HasTarget), Mode=OneWay}">
                                    <TextBlock Text="{x:Bind ConfidenceText, Mode=OneWay}" FontSize="10" Foreground="White" />
                                </Border>
                                <TextBlock Text="{x:Bind TargetText, Mode=OneWay}" FontSize="12" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{x:Bind ReasonText, Mode=OneWay}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                            <Button Content="移動" Click="Move_Click" Style="{StaticResource AccentButtonStyle}"
                                    IsEnabled="{x:Bind HasTarget, Mode=OneWay}" ToolTipService.ToolTip="推奨先へ移動" />
                            <Button Click="Choose_Click" ToolTipService.ToolTip="ほかの候補・新しいフォルダ・ルール化">
                                <FontIcon Glyph="&#xE712;" FontSize="14" />
                            </Button>
                            <Button Click="Dismiss_Click" ToolTipService.ToolTip="このままにする（一覧から外す）">
                                <FontIcon Glyph="&#xE711;" FontSize="12" />
                            </Button>
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <TextBlock Grid.Row="1" Text="新しく届いたファイルはここに表示され、置き場所を提案します。"
                   Visibility="{x:Bind views:InboxPaneView.EmptyVisibility(ViewModel.Summary), Mode=OneWay}"
                   HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
    </Grid>
</UserControl>
