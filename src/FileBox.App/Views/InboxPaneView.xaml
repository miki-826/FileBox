<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="FileBox.App.Views.InboxPaneView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:FileBox.App.Models"
    xmlns:services="using:FileBox.App.Services"
    xmlns:views="using:FileBox.App.Views">

    <UserControl.Resources>
        <Style x:Key="InboxItem" TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
            <Setter Property="MinHeight" Value="90" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
    </UserControl.Resources>

    <Grid RowDefinitions="Auto,*">
        <Grid Padding="16,14" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12"
              BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
            <FontIcon Glyph="&#xE896;" FontSize="20" Foreground="#30A46C" />
            <StackPanel Grid.Column="1" Spacing="4">
                <TextBlock Text="受け取りボックス" FontWeight="SemiBold" />
                <TextBlock Text="{x:Bind ViewModel.Summary, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6">
                <Button Click="MoveAll_Click" Style="{StaticResource AccentButtonStyle}" AutomationProperties.Name="確信度「高」とルール一致の項目を推奨先へまとめて移動" ToolTipService.ToolTip="確信度「高」とルール一致の項目を推奨先へまとめて移動">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE8DE;" FontSize="14" />
                        <TextBlock Text="まとめて振り分け" />
                    </StackPanel>
                </Button>
                <Button Click="Settings_Click" AutomationProperties.Name="監視フォルダと振り分けルール" ToolTipService.ToolTip="監視フォルダと振り分けルール">
                    <FontIcon Glyph="&#xE713;" FontSize="14" />
                </Button>
            </StackPanel>
        </Grid>

        <ListView x:Name="List" Grid.Row="1" Margin="4,6,4,0" AutomationProperties.Name="振り分け待ちのファイル一覧"
                  SelectionMode="Single"
                  ItemContainerStyle="{StaticResource InboxItem}"
                  DoubleTapped="List_DoubleTapped"
                  SelectionChanged="List_SelectionChanged">
            <!-- 見出しの固定表示は区画の分割（付け替え）で位置がずれるため使わない -->
            <ListView.ItemsPanel>
                <ItemsPanelTemplate>
                    <ItemsStackPanel AreStickyGroupHeadersEnabled="False" />
                </ItemsPanelTemplate>
            </ListView.ItemsPanel>
            <!-- 届いた日でまとめる（今日・昨日・今週・先週・今月…） -->
            <ListView.GroupStyle>
                <GroupStyle HidesIfEmpty="True">
                    <GroupStyle.HeaderTemplate>
                        <DataTemplate x:DataType="models:ItemGroup">
                            <TextBlock Text="{x:Bind Header}" FontSize="14" FontWeight="SemiBold" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                        </DataTemplate>
                    </GroupStyle.HeaderTemplate>
                </GroupStyle>
            </ListView.GroupStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="services:InboxItem">
                    <Grid ColumnDefinitions="34,*,Auto" ColumnSpacing="8">
                        <FontIcon Glyph="{x:Bind Glyph}" FontSize="22" HorizontalAlignment="Left" VerticalAlignment="Center" Foreground="{x:Bind views:Converters.ItemBrush(FullPath, Extension, x:False, x:False)}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                            <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Name}" />
                            <TextBlock Text="{x:Bind Detail}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Detail}" />
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" Margin="0,2,0,0">
                                <Border CornerRadius="4" Padding="5,0" VerticalAlignment="Center"
                                        Background="{x:Bind views:InboxPaneView.BadgeBrush(Confidence, HasTarget), Mode=OneWay}"
                                        Visibility="{x:Bind views:Converters.Visible(HasTarget), Mode=OneWay}">
                                    <TextBlock Text="{x:Bind ConfidenceText, Mode=OneWay}" FontSize="12" Foreground="White" />
                                </Border>
                                <TextBlock Grid.Column="1" Text="{x:Bind TargetText, Mode=OneWay}" FontSize="12" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind TargetText, Mode=OneWay}" />
                            </Grid>
                            <TextBlock Text="{x:Bind ReasonText, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                            <Button Content="移動" Click="Move_Click" Style="{StaticResource AccentButtonStyle}"
                                    IsEnabled="{x:Bind HasTarget, Mode=OneWay}" AutomationProperties.Name="推奨先へ移動" ToolTipService.ToolTip="推奨先へ移動" />
                            <Button Click="Choose_Click" AutomationProperties.Name="ほかの候補・新しいフォルダ・ルール化" ToolTipService.ToolTip="ほかの候補・新しいフォルダ・ルール化">
                                <FontIcon Glyph="&#xE712;" FontSize="14" />
                            </Button>
                            <Button Click="Dismiss_Click" AutomationProperties.Name="このままにする（一覧から外す）" ToolTipService.ToolTip="このままにする（一覧から外す）">
                                <FontIcon Glyph="&#xE711;" FontSize="12" />
                            </Button>
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <TextBlock Grid.Row="1" Text="新しく届いたファイルはここに表示され、置き場所を提案します。"
                   Visibility="{x:Bind views:InboxPaneView.EmptyVisibility(ViewModel.Summary), Mode=OneWay}"
                   HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" TextAlignment="Center" Margin="32" MaxWidth="360" />
    </Grid>
</UserControl>
