<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="FileBox.App.Views.PreviewPaneView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid RowDefinitions="Auto,*,Auto">
        <Grid Padding="16,14" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12"
              BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
            <FontIcon x:Name="HeaderIcon" Glyph="&#xE8A1;" FontSize="22" />
            <StackPanel Grid.Column="1" Spacing="4">
                <TextBlock x:Name="HeaderName" Text="ファイルを選択するとここに表示されます" TextTrimming="CharacterEllipsis" FontWeight="SemiBold" />
                <TextBlock x:Name="HeaderDetail" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <Button x:Name="OpenButton" Grid.Column="2" Content="開く" Click="Open_Click" IsEnabled="False" MinHeight="36" />
        </Grid>
        <Grid x:Name="ContentHost" Grid.Row="1" />
        <!-- 詳細（エクスプローラーの詳細ウィンドウと同じく、種類・サイズ・日時・属性・撮影日や長さなど） -->
        <Border x:Name="DetailsHost" Grid.Row="2" Visibility="Collapsed" Padding="16,10,16,12"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
            <StackPanel Spacing="6">
                <TextBlock Text="詳細" FontWeight="SemiBold" />
                <ScrollViewer MaxHeight="260" VerticalScrollBarVisibility="Auto">
                    <Grid x:Name="DetailsGrid" ColumnDefinitions="Auto,*" ColumnSpacing="16" RowSpacing="4" />
                </ScrollViewer>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
