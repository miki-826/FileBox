<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="FileBox.App.Views.PreviewPaneView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid RowDefinitions="Auto,*">
        <Grid Padding="12,8" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8"
              BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
            <FontIcon x:Name="HeaderIcon" Glyph="&#xE8A1;" FontSize="16" />
            <StackPanel Grid.Column="1">
                <TextBlock x:Name="HeaderName" Text="ファイルを選択するとここに表示されます" TextTrimming="CharacterEllipsis" FontWeight="SemiBold" />
                <TextBlock x:Name="HeaderDetail" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <Button x:Name="OpenButton" Grid.Column="2" Content="開く" Click="Open_Click" IsEnabled="False" />
        </Grid>
        <Grid x:Name="ContentHost" Grid.Row="1" />
    </Grid>
</UserControl>
