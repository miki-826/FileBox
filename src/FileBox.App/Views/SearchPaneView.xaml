<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="FileBox.App.Views.SearchPaneView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:FileBox.App.Models"
    xmlns:views="using:FileBox.App.Views">

    <UserControl.Resources>
        <Style x:Key="CompactItem" TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
            <Setter Property="MinHeight" Value="54" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="CornerRadius" Value="6" />
        </Style>
    </UserControl.Resources>

    <Grid RowDefinitions="Auto,Auto,*">
        <Grid Padding="16,14" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12"
              BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
            <FontIcon Glyph="&#xE721;" FontSize="20" />
            <StackPanel Grid.Column="1" Spacing="4">
                <TextBlock Text="{x:Bind ViewModel.Query, Mode=OneWay}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{x:Bind ViewModel.Summary, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                <ProgressRing IsActive="{x:Bind ViewModel.IsSearching, Mode=OneWay}" Width="18" Height="18" />
                <Button Content="さらに表示" Click="LoadMore_Click" Visibility="{x:Bind views:Converters.Visible(ViewModel.CanLoadMore), Mode=OneWay}" />
            </StackPanel>
        </Grid>

        <InfoBar Grid.Row="1" Severity="Warning" IsClosable="False" Message="{x:Bind ViewModel.ErrorText, Mode=OneWay}"
                 IsOpen="True" Visibility="{x:Bind views:Converters.VisibleIf(ViewModel.ErrorText), Mode=OneWay}" />

        <ListView x:Name="List" Grid.Row="2" Margin="4,6,4,0" AutomationProperties.Name="検索結果一覧"
                  ItemsSource="{x:Bind ViewModel.Results, Mode=OneWay}"
                  SelectionMode="Extended"
                  ItemContainerStyle="{StaticResource CompactItem}"
                  DoubleTapped="List_DoubleTapped"
                  SelectionChanged="List_SelectionChanged"
                  RightTapped="List_RightTapped"
                  KeyDown="List_KeyDown">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:FileItem">
                    <Grid ColumnDefinitions="42,*,90,130">
                        <views:FileItemIcon ItemPath="{x:Bind FullPath}" Extension="{x:Bind Extension}" IsDirectory="{x:Bind IsDirectory}" IsDrive="{x:Bind IsDrive}" HorizontalAlignment="Left" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0" Spacing="3">
                            <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Name}" />
                            <TextBlock Text="{x:Bind Location}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Location}" />
                        </StackPanel>
                        <TextBlock Grid.Column="2" Text="{x:Bind HumanSize, Mode=OneWay}" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Grid.Column="3" Text="{x:Bind ModifiedText}" FontSize="12" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</UserControl>
