<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="FileBox.App.Views.FolderPaneView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:FileBox.App.Models"
    xmlns:views="using:FileBox.App.Views">

    <UserControl.Resources>
        <Style x:Key="NavButton" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="MinWidth" Value="40" />
            <Setter Property="MinHeight" Value="40" />
            <Setter Property="CornerRadius" Value="6" />
        </Style>
        <Style x:Key="HeaderButton" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding" Value="4,8" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        </Style>
        <Style x:Key="CompactItem" TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
            <Setter Property="MinHeight" Value="40" />
            <Setter Property="Padding" Value="8,3" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="CornerRadius" Value="4" />
        </Style>
        <Style x:Key="NavToggle" TargetType="ToggleButton" BasedOn="{StaticResource DefaultToggleButtonStyle}">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="MinWidth" Value="40" />
            <Setter Property="MinHeight" Value="40" />
            <Setter Property="CornerRadius" Value="6" />
        </Style>
    </UserControl.Resources>

    <Grid RowDefinitions="Auto,Auto,Auto,*">
        <!-- ナビゲーション + アドレスバー -->
        <Grid x:Name="NavigationRow" Grid.Row="0" ColumnDefinitions="Auto,Auto,Auto,Auto,*" Padding="8,10" ColumnSpacing="2">
            <Button x:Name="BackButton" Style="{StaticResource NavButton}" Click="Back_Click" AutomationProperties.Name="戻る (Alt+←)" ToolTipService.ToolTip="戻る (Alt+←)">
                <FontIcon Glyph="&#xE72B;" FontSize="16" />
            </Button>
            <Button x:Name="ForwardButton" Grid.Column="1" Style="{StaticResource NavButton}" Click="Forward_Click" AutomationProperties.Name="進む (Alt+→)" ToolTipService.ToolTip="進む (Alt+→)">
                <FontIcon Glyph="&#xE72A;" FontSize="16" />
            </Button>
            <Button x:Name="UpButton" Grid.Column="2" Style="{StaticResource NavButton}" Click="Up_Click" AutomationProperties.Name="上へ (Alt+↑)" ToolTipService.ToolTip="上へ (Alt+↑)">
                <FontIcon Glyph="&#xE74A;" FontSize="16" />
            </Button>
            <Button x:Name="RefreshButton" Grid.Column="3" Style="{StaticResource NavButton}" Click="Refresh_Click" AutomationProperties.Name="最新の情報に更新 (F5)" ToolTipService.ToolTip="最新の情報に更新 (F5)">
                <FontIcon Glyph="&#xE72C;" FontSize="16" />
            </Button>

            <Grid x:Name="AddressArea" Grid.Column="4" Margin="4,0">
                <Border x:Name="BreadcrumbHost" CornerRadius="6" Padding="8,0" MinHeight="40"
                        Background="{ThemeResource ControlFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1"
                        Tapped="BreadcrumbHost_Tapped">
                    <BreadcrumbBar x:Name="Breadcrumb" VerticalAlignment="Center" ItemClicked="Breadcrumb_ItemClicked" />
                </Border>
                <TextBox x:Name="AddressBox" Visibility="Collapsed" VerticalAlignment="Center" AutomationProperties.Name="フォルダのパス"
                         KeyDown="AddressBox_KeyDown" LostFocus="AddressBox_LostFocus"
                         PlaceholderText="パス・%USERPROFILE%・shell:Downloads を入力" />
            </Grid>

        </Grid>

        <!-- 操作は名前付きで一覧の直上に集約。狭い区画では CommandBar のメニューへ移る。 -->
        <CommandBar Grid.Row="1" DefaultLabelPosition="Right" IsDynamicOverflowEnabled="True" OverflowButtonVisibility="Auto"
                    Background="Transparent" HorizontalAlignment="Left" Padding="4,2" AutomationProperties.Name="ファイル操作">
            <AppBarButton x:Name="NewFolderButton" Label="新規フォルダ" Icon="NewFolder" Click="NewFolder_Click" ToolTipService.ToolTip="新しいフォルダー (Ctrl+Shift+N)" />
            <AppBarSeparator />
            <AppBarButton x:Name="CutButton" Label="切り取り" Icon="Cut" Click="Cut_Click" ToolTipService.ToolTip="切り取り (Ctrl+X)" />
            <AppBarButton x:Name="CopyButton" Label="コピー" Icon="Copy" Click="Copy_Click" ToolTipService.ToolTip="コピー (Ctrl+C)" />
            <AppBarButton x:Name="PasteButton" Label="貼り付け" Icon="Paste" Click="Paste_Click" ToolTipService.ToolTip="貼り付け (Ctrl+V)" />
            <AppBarButton x:Name="RenameButton" Label="名前の変更" Icon="Rename" Click="Rename_Click" ToolTipService.ToolTip="名前の変更 (F2)" />
            <AppBarButton x:Name="DeleteButton" Label="削除" Icon="Delete" Click="Delete_Click" ToolTipService.ToolTip="ごみ箱へ移動 (Delete)" />
            <AppBarSeparator />
            <AppBarToggleButton x:Name="GroupButton" Label="日付でまとめる" Icon="Calendar" Click="Group_Click" />
            <AppBarButton x:Name="OrganizeButton" Label="整理の提案" Icon="MoveToFolder" Click="Organize_Click" Visibility="Collapsed" ToolTipService.ToolTip="ダウンロードのファイルに保存先を提案" />
            <AppBarButton Label="プレビュー" Icon="Preview" Click="Preview_Click" ToolTipService.ToolTip="プレビューと詳細 (Space)" />
        </CommandBar>

        <!-- 列ヘッダー（クリックで並べ替え） -->
        <Grid x:Name="HeaderGrid" Grid.Row="2" Margin="4,0,4,0" Padding="8,0" ColumnDefinitions="42,*,150,140,110"
              Background="{ThemeResource LayerFillColorAltBrush}"
              BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
            <Button x:Name="NameHeader" Grid.Column="1" Style="{StaticResource HeaderButton}" Click="SortName_Click" Content="名前" />
            <Button x:Name="ModifiedHeader" Grid.Column="2" Style="{StaticResource HeaderButton}" Click="SortModified_Click" Content="更新日時" />
            <Button x:Name="TypeHeader" Grid.Column="3" Style="{StaticResource HeaderButton}" Click="SortType_Click" Content="種類" />
            <Button x:Name="SizeHeader" Grid.Column="4" Style="{StaticResource HeaderButton}" Click="SortSize_Click" Content="サイズ" HorizontalContentAlignment="Right" />
        </Grid>

        <Grid Grid.Row="3">
            <ListView x:Name="List" Margin="4,4,4,0" AutomationProperties.Name="フォルダ内のファイル一覧"
                      SelectionMode="Extended"
                      ItemContainerStyle="{StaticResource CompactItem}"
                      DoubleTapped="List_DoubleTapped"
                      SelectionChanged="List_SelectionChanged"
                      RightTapped="List_RightTapped"
                      KeyDown="List_KeyDown"
                      SizeChanged="List_SizeChanged"
                      ContainerContentChanging="List_ContainerContentChanging"
                      CanDragItems="True"
                      DragItemsStarting="List_DragItemsStarting"
                      AllowDrop="True"
                      DragOver="List_DragOver"
                      DragLeave="List_DragLeave"
                      Drop="List_Drop">
                <!-- 見出しの固定表示は区画の分割（付け替え）で位置がずれるため使わない -->
                <ListView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <ItemsStackPanel AreStickyGroupHeadersEnabled="False" />
                    </ItemsPanelTemplate>
                </ListView.ItemsPanel>
                <!-- 日付でまとめるときの見出し（ItemsSource をグループ化したときだけ使われる） -->
                <ListView.GroupStyle>
                    <GroupStyle HidesIfEmpty="True">
                        <GroupStyle.HeaderTemplate>
                            <DataTemplate x:DataType="models:ItemGroup">
                                <TextBlock Text="{x:Bind Header}" FontSize="14" FontWeight="SemiBold" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                            </DataTemplate>
                        </GroupStyle.HeaderTemplate>
                    </GroupStyle>
                </ListView.GroupStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:FileItem">
                        <Grid ColumnDefinitions="42,*,150,140,110" Opacity="{x:Bind ItemOpacity}">
                            <views:FileItemIcon ItemPath="{x:Bind FullPath}" Extension="{x:Bind Extension}" IsDirectory="{x:Bind IsDirectory}" IsDrive="{x:Bind IsDrive}" HorizontalAlignment="Left" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0">
                                <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Name}" />
                                <ProgressBar Visibility="{x:Bind views:Converters.Visible(IsDrive)}" Value="{x:Bind views:Converters.Percent(DriveUsage)}"
                                             Foreground="{x:Bind views:Converters.UsageBrush(DriveUsage)}" Margin="0,3,0,3" HorizontalAlignment="Left" Width="200" MaxWidth="240" />
                            </StackPanel>
                            <TextBlock Grid.Column="2" Text="{x:Bind ModifiedText}" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" />
                            <TextBlock Grid.Column="3" Text="{x:Bind TypeText}" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="4" Text="{x:Bind SizeText, Mode=OneWay}" ToolTipService.ToolTip="{x:Bind SizeDescription, Mode=OneWay}" VerticalAlignment="Center" HorizontalAlignment="Right" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <TextBlock Text="{x:Bind ViewModel.ErrorText, Mode=OneWay}" Visibility="{x:Bind views:Converters.VisibleIf(ViewModel.ErrorText), Mode=OneWay}"
                       HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Margin="24" />
            <ProgressRing IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" Width="28" Height="28" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,24,0,0" />
        </Grid>
    </Grid>
</UserControl>
