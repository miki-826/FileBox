<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>FileBox.App</RootNamespace>
    <AssemblyName>FileBox</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\FileBox.ico</ApplicationIcon>
    <Platforms>x64;ARM64</Platforms>
    <Platform Condition="'$(Platform)' == '' or '$(Platform)' == 'AnyCPU'">x64</Platform>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-$(Platform.ToLower())</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>false</SelfContained>
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.6.250205002" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.1742" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.3.2" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\FileBox.ico;Assets\FileBox.png;Assets\Strings\en.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FileBox.Contracts\FileBox.Contracts.csproj" />
    <ProjectReference Include="..\FileBox.Core\FileBox.Core.csproj" />
    <ProjectReference Include="..\FileBox.Data\FileBox.Data.csproj" />
    <ProjectReference Include="..\FileBox.Indexer\FileBox.Indexer.csproj" ReferenceOutputAssembly="false" Private="false" />
  </ItemGroup>

  <!-- Indexer を App の出力フォルダへ同梱する（App が自動起動する） -->
  <Target Name="CopyIndexer" AfterTargets="Build">
    <MSBuild Projects="..\FileBox.Indexer\FileBox.Indexer.csproj" Targets="GetTargetPath"
             Properties="Configuration=$(Configuration);Platform=$(Platform)">
      <Output TaskParameter="TargetOutputs" ItemName="IndexerTargetPath" />
    </MSBuild>
    <PropertyGroup>
      <IndexerOutputDirectory>@(IndexerTargetPath->'%(RootDir)%(Directory)')</IndexerOutputDirectory>
    </PropertyGroup>
    <ItemGroup>
      <IndexerFiles Include="$(IndexerOutputDirectory)**\*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(IndexerFiles)" DestinationFolder="$(OutDir)indexer\%(RecursiveDir)" SkipUnchangedFiles="true" />
  </Target>
</Project>
