<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="FileBox.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:FileBox.App.Models"
    xmlns:views="using:FileBox.App.Views"
    Title="FileBox">

    <Grid x:Name="Root" SizeChanged="Root_SizeChanged" RowDefinitions="Auto,*,Auto" Background="{ThemeResource LayerFillColorAltBrush}">
        <Grid.Resources>
            <DataTemplate x:Key="SidebarTemplate" x:DataType="models:SidebarItem">
                <Grid ColumnDefinitions="34,*" Padding="0,4" ToolTipService.ToolTip="{x:Bind Tooltip}">
                    <FontIcon Glyph="{x:Bind Glyph}" FontSize="18" HorizontalAlignment="Left" Foreground="{x:Bind views:Converters.HexBrush(Color)}" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" FontSize="14" />
                    </StackPanel>
                </Grid>
            </DataTemplate>
            <Style x:Key="SidebarList" TargetType="ListView">
                <Setter Property="SelectionMode" Value="Single" />
                <Setter Property="IsItemClickEnabled" Value="True" />
                <Setter Property="ItemTemplate" Value="{StaticResource SidebarTemplate}" />
                <Setter Property="Margin" Value="6,0" />
                <Setter Property="ItemContainerStyle">
                    <Setter.Value>
                        <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                            <Setter Property="MinHeight" Value="38" />
                            <Setter Property="Padding" Value="10,2" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="CornerRadius" Value="6" />
                            <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
                        </Style>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="SidebarHeader" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Margin" Value="16,0,0,0" />
            </Style>
            <!-- 見出しの右のボタン（＋・保存・折りたたみ） -->
            <Style x:Key="SidebarHeaderButton" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="6,4" />
                <Setter Property="MinWidth" Value="34" />
                <Setter Property="MinHeight" Value="32" />
                <Setter Property="CornerRadius" Value="6" />
            </Style>
            <Style x:Key="SidebarSection" TargetType="Grid">
                <Setter Property="Margin" Value="0,16,8,4" />
            </Style>
            <Style x:Key="SidebarFooterButton" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Left" />
                <Setter Property="Padding" Value="10,8" />
                <Setter Property="MinHeight" Value="42" />
                <Setter Property="CornerRadius" Value="6" />
            </Style>
            <Style x:Key="TopNavButton" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="8,6" />
                <Setter Property="MinWidth" Value="40" />
                <Setter Property="MinHeight" Value="40" />
                <Setter Property="CornerRadius" Value="6" />
            </Style>
            <Style x:Key="Chip" TargetType="ToggleButton" BasedOn="{StaticResource DefaultToggleButtonStyle}">
                <Setter Property="CornerRadius" Value="14" />
                <Setter Property="Padding" Value="12,5" />
                <Setter Property="MinHeight" Value="32" />
                <Setter Property="FontSize" Value="12" />
            </Style>
            <Style x:Key="ChipDrop" TargetType="DropDownButton" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="CornerRadius" Value="14" />
                <Setter Property="Padding" Value="12,5" />
                <Setter Property="MinHeight" Value="32" />
                <Setter Property="FontSize" Value="12" />
            </Style>
            <!-- 検索欄の入力部分。アドレスバーと同じ高さ・角丸にし、文字を縦の中央に置く -->
            <Style x:Key="SearchTextBox" TargetType="TextBox" BasedOn="{StaticResource AutoSuggestBoxTextBoxStyle}">
                <Setter Property="MinHeight" Value="40" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="12,0,6,0" />
            </Style>
        </Grid.Resources>

        <!-- 上のバー: 移動・場所・検索。詳細条件は必要なときだけ開く。 -->
        <Grid Grid.Row="0" Padding="16,10,16,10" x:Name="TopBar" ColumnDefinitions="228,Auto,3*,2*,Auto" ColumnSpacing="10" RowSpacing="8"
              BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
            <StackPanel x:Name="BrandPanel" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Image Source="ms-appx:///Assets/FileBox.png" Width="28" Height="28" AutomationProperties.Name="FileBox" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="FileBox" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock Text="開発プレビュー" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                <Button x:Name="TopBackButton" Style="{StaticResource TopNavButton}" Click="TopBack_Click" AutomationProperties.Name="戻る (Alt+←)" ToolTipService.ToolTip="戻る (Alt+←)">
                    <FontIcon Glyph="&#xE72B;" FontSize="16" />
                </Button>
                <Button x:Name="TopForwardButton" Style="{StaticResource TopNavButton}" Click="TopForward_Click" AutomationProperties.Name="進む (Alt+→)" ToolTipService.ToolTip="進む (Alt+→)">
                    <FontIcon Glyph="&#xE72A;" FontSize="16" />
                </Button>
                <Button x:Name="TopUpButton" Style="{StaticResource TopNavButton}" Click="TopUp_Click" AutomationProperties.Name="上へ (Alt+↑)" ToolTipService.ToolTip="上へ (Alt+↑)">
                    <FontIcon Glyph="&#xE74A;" FontSize="16" />
                </Button>
                <Button Style="{StaticResource TopNavButton}" Click="TopRefresh_Click" AutomationProperties.Name="最新の情報に更新 (F5)" ToolTipService.ToolTip="最新の情報に更新 (F5)">
                    <FontIcon Glyph="&#xE72C;" FontSize="16" />
                </Button>
            </StackPanel>

            <!-- アドレスバー: 選択中の区画のフォルダ。余白をクリックするとパスを直接入力できる -->
            <Grid Grid.Column="2" VerticalAlignment="Center">
                <Border x:Name="TopBreadcrumbHost" CornerRadius="8" Padding="10,0" MinHeight="40"
                        Background="{ThemeResource ControlFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1"
                        Tapped="TopBreadcrumbHost_Tapped" ToolTipService.ToolTip="クリックしてパスを入力（Ctrl+L）">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                        <FontIcon x:Name="TopAddressIcon" Glyph="&#xE8B7;" FontSize="16" VerticalAlignment="Center" />
                        <BreadcrumbBar x:Name="TopBreadcrumb" Grid.Column="1" VerticalAlignment="Center" ItemClicked="TopBreadcrumb_ItemClicked" />
                    </Grid>
                </Border>
                <TextBox x:Name="TopAddressBox" Visibility="Collapsed" MinHeight="40" VerticalContentAlignment="Center" CornerRadius="8"
                         AutomationProperties.Name="フォルダのパス" PlaceholderText="パス・%USERPROFILE%・shell:Downloads を入力して Enter"
                         KeyDown="TopAddressBox_KeyDown" LostFocus="TopAddressBox_LostFocus" />
            </Grid>

            <!-- 検索: アドレスバーの右（エクスプローラーと同じ位置）。何を検索するかを入力欄の中に表示する -->
            <!-- 高さは中の入力欄で決める（外側だけ高くすると文字が上に寄るため）。縦の位置は本体の VerticalContentAlignment が入力欄へ渡る -->
            <AutoSuggestBox x:Name="SearchBox" Grid.Column="3" MinWidth="180" VerticalAlignment="Center" VerticalContentAlignment="Center" CornerRadius="8"
                            TextBoxStyle="{StaticResource SearchTextBox}"
                            AutomationProperties.Name="ファイルとフォルダを検索"
                            PlaceholderText="PC 全体を検索（Ctrl+F）"
                            QueryIcon="Find"
                            UpdateTextOnSelect="False"
                            TextChanged="SearchBox_TextChanged"
                            QuerySubmitted="SearchBox_QuerySubmitted"
                            GotFocus="SearchBox_GotFocus"
                            LostFocus="SearchBox_LostFocus"
                            MaxSuggestionListHeight="300"
                            ToolTipService.ToolTip="入力すると候補を表示。↑↓で選択、Enterで確定、Escで閉じます。">
                <AutoSuggestBox.ItemContainerStyle>
                    <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="10,2" />
                        <Setter Property="MinHeight" Value="44" />
                    </Style>
                </AutoSuggestBox.ItemContainerStyle>
                <AutoSuggestBox.ItemTemplate>
                    <DataTemplate x:DataType="models:SearchSuggestionItem">
                        <StackPanel Spacing="4" Padding="0,4" HorizontalAlignment="Stretch">
                            <TextBlock Text="{x:Bind Group}" Visibility="{x:Bind views:Converters.VisibleIf(Group)}"
                                       FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <Grid ColumnDefinitions="34,*" ColumnSpacing="8" MinHeight="38">
                                <views:FileItemIcon ItemPath="{x:Bind ItemPath}" IsDirectory="{x:Bind IsDirectory}" Extension="{x:Bind Extension}"
                                                    Visibility="{x:Bind views:Converters.Visible(IsLocation)}" />
                                <FontIcon Glyph="{x:Bind Glyph}" FontSize="16" Visibility="{x:Bind views:Converters.Collapsed(IsLocation)}"
                                          Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Text="{x:Bind Title}" Tag="data" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Title}" />
                                    <TextBlock Text="{x:Bind Detail}" Tag="data" FontSize="11" TextTrimming="CharacterEllipsis"
                                               Visibility="{x:Bind views:Converters.VisibleIf(Detail)}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               ToolTipService.ToolTip="{x:Bind Detail}" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </DataTemplate>
                </AutoSuggestBox.ItemTemplate>
            </AutoSuggestBox>

            <Button Grid.Column="4" MinHeight="40" Padding="10,6" AutomationProperties.Name="検索条件を設定" ToolTipService.ToolTip="種類・一致方法・更新日・検索範囲を設定">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE71C;" FontSize="16" />
                    <TextBlock x:Name="FilterSummary" Text="検索条件" VerticalAlignment="Center" />
                </StackPanel>
                <Button.Flyout>
                    <Flyout Placement="BottomEdgeAlignedRight">
                        <StackPanel Width="390" Spacing="10">
                            <TextBlock Text="検索条件" FontSize="18" FontWeight="SemiBold" />
                            <TextBlock Text="条件は検索欄にも反映されます。" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Text="検索対象" Style="{StaticResource SidebarHeader}" Margin="0,8,0,0" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <ToggleButton x:Name="FolderChip" Style="{StaticResource Chip}" Content="フォルダのみ" Click="FolderChip_Click" />
                                <ToggleButton x:Name="FileChip" Style="{StaticResource Chip}" Content="ファイルのみ" Click="FileChip_Click" />
                            </StackPanel>
                            <TextBlock Text="名前の一致方法" Style="{StaticResource SidebarHeader}" Margin="0,8,0,0" />
                            <DropDownButton x:Name="ModeChip" Style="{StaticResource ChipDrop}" Content="一致: 部分一致">
                                <DropDownButton.Flyout>
                                    <MenuFlyout Placement="BottomEdgeAlignedLeft">
                                        <MenuFlyoutItem Text="部分一致（既定）" Tag="substring" Click="Mode_Click" />
                                        <MenuFlyoutItem Text="前方一致（先頭の文字）" Tag="prefix" Click="Mode_Click" />
                                        <MenuFlyoutItem Text="完全一致" Tag="exact" Click="Mode_Click" />
                                        <MenuFlyoutItem Text="ワイルドカード（* ?）" Tag="wildcard" Click="Mode_Click" />
                                        <MenuFlyoutItem Text="正規表現" Tag="regex" Click="Mode_Click" />
                                        <MenuFlyoutItem Text="あいまい（ローマ字・かな）" Tag="fuzzy" Click="Mode_Click" />
                                    </MenuFlyout>
                                </DropDownButton.Flyout>
                            </DropDownButton>
                            <TextBlock Text="ファイルの種類と更新日" Style="{StaticResource SidebarHeader}" Margin="0,8,0,0" />
                            <StackPanel Spacing="8">
                                <DropDownButton x:Name="ExtChip" Style="{StaticResource ChipDrop}" Content="拡張子">
                                    <DropDownButton.Flyout>
                                        <MenuFlyout Placement="BottomEdgeAlignedLeft">
                                            <MenuFlyoutItem Text="指定なし" Tag="" Click="Ext_Click" />
                                            <MenuFlyoutItem Text="PDF" Tag="pdf" Click="Ext_Click" />
                                            <MenuFlyoutItem Text="Office（Word/Excel/PowerPoint）" Tag="doc,docx,xls,xlsx,xlsm,ppt,pptx" Click="Ext_Click" />
                                            <MenuFlyoutItem Text="画像" Tag="jpg,jpeg,png,gif,bmp,webp,heic" Click="Ext_Click" />
                                            <MenuFlyoutItem Text="動画" Tag="mp4,mov,wmv,avi,mkv" Click="Ext_Click" />
                                            <MenuFlyoutItem Text="音楽" Tag="mp3,wav,m4a,flac" Click="Ext_Click" />
                                            <MenuFlyoutItem Text="テキスト・CSV" Tag="txt,md,csv,log" Click="Ext_Click" />
                                            <MenuFlyoutItem Text="圧縮ファイル" Tag="zip,7z,rar" Click="Ext_Click" />
                                            <MenuFlyoutItem Text="実行ファイル" Tag="exe,msi" Click="Ext_Click" />
                                        </MenuFlyout>
                                    </DropDownButton.Flyout>
                                </DropDownButton>
                                <DropDownButton x:Name="DateChip" Style="{StaticResource ChipDrop}" Content="期間">
                                    <DropDownButton.Flyout>
                                        <MenuFlyout Placement="BottomEdgeAlignedLeft">
                                            <MenuFlyoutItem Text="指定なし" Tag="" Click="Date_Click" />
                                            <MenuFlyoutItem Text="今日" Tag="today" Click="Date_Click" />
                                            <MenuFlyoutItem Text="昨日" Tag="yesterday" Click="Date_Click" />
                                            <MenuFlyoutItem Text="今週" Tag="thisweek" Click="Date_Click" />
                                            <MenuFlyoutItem Text="今月" Tag="thismonth" Click="Date_Click" />
                                            <MenuFlyoutItem Text="先月" Tag="lastmonth" Click="Date_Click" />
                                            <MenuFlyoutItem Text="今年" Tag="thisyear" Click="Date_Click" />
                                        </MenuFlyout>
                                    </DropDownButton.Flyout>
                                </DropDownButton>
                            </StackPanel>
                            <TextBlock Text="検索する場所" Style="{StaticResource SidebarHeader}" Margin="0,8,0,0" />
                            <ToggleButton x:Name="InFolderChip" Style="{StaticResource Chip}" Content="このフォルダ内" Click="InFolderChip_Click" />
                            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,12,0,0">
                                <Button Content="検索を保存" FontSize="12" CornerRadius="14" Padding="12,5" Click="SaveSearch_Click" />
                                <HyperlinkButton Content="検索の書き方" FontSize="12" Click="SearchHelp_Click" />
                                <Button Content="条件をリセット" Click="ResetSearchFilters_Click" />
                            </StackPanel>
                        </StackPanel>
                    </Flyout>
                </Button.Flyout>
            </Button>
        </Grid>

        <Grid x:Name="WorkspaceGrid" Grid.Row="1" ColumnDefinitions="248,*" Padding="0,8,12,10" ColumnSpacing="8">
            <!-- サイドバー。各見出しの右の矢印で折りたためる -->
            <Grid Grid.Column="0" RowDefinitions="*,Auto"
                  BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,1,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel x:Name="SidebarPanel" Padding="0,0,0,12">
                    <ListView x:Name="InboxList" Style="{StaticResource SidebarList}" ItemClick="Sidebar_ItemClick" Margin="0,8,0,0" />

                    <Grid Style="{StaticResource SidebarSection}" ColumnDefinitions="*,Auto">
                        <TextBlock Style="{StaticResource SidebarHeader}" Text="クイック アクセス" />
                        <Button x:Name="QuickToggle" Grid.Column="1" Style="{StaticResource SidebarHeaderButton}" />
                    </Grid>
                    <ListView x:Name="QuickList" Style="{StaticResource SidebarList}" ItemClick="Sidebar_ItemClick" RightTapped="Sidebar_RightTapped" />

                    <Grid Style="{StaticResource SidebarSection}" ColumnDefinitions="*,Auto,Auto">
                        <TextBlock Style="{StaticResource SidebarHeader}" Text="お気に入り" />
                        <Button Grid.Column="1" Style="{StaticResource SidebarHeaderButton}"
                                AutomationProperties.Name="表示中のフォルダを追加" ToolTipService.ToolTip="表示中のフォルダを追加" Click="AddFavorite_Click">
                            <FontIcon Glyph="&#xE710;" FontSize="16" />
                        </Button>
                        <Button x:Name="FavoriteToggle" Grid.Column="2" Style="{StaticResource SidebarHeaderButton}" />
                    </Grid>
                    <ListView x:Name="FavoriteList" Style="{StaticResource SidebarList}" ItemClick="Sidebar_ItemClick" RightTapped="Sidebar_RightTapped" />

                    <Grid Style="{StaticResource SidebarSection}" ColumnDefinitions="*,Auto">
                        <TextBlock Style="{StaticResource SidebarHeader}" Text="最近使ったフォルダ" />
                        <Button x:Name="RecentToggle" Grid.Column="1" Style="{StaticResource SidebarHeaderButton}" />
                    </Grid>
                    <ListView x:Name="RecentList" Style="{StaticResource SidebarList}" ItemClick="Sidebar_ItemClick" RightTapped="Sidebar_RightTapped" />

                    <!-- 星・タグ（FileBox の中だけの印）。印を付けたものがあるときだけ表示 -->
                    <Grid x:Name="TagHeader" Style="{StaticResource SidebarSection}" ColumnDefinitions="*,Auto" Visibility="Collapsed">
                        <TextBlock Style="{StaticResource SidebarHeader}" Text="星・タグ" />
                        <Button x:Name="TagToggle" Grid.Column="1" Style="{StaticResource SidebarHeaderButton}" />
                    </Grid>
                    <ListView x:Name="TagList" Style="{StaticResource SidebarList}" ItemClick="Sidebar_ItemClick" RightTapped="Sidebar_RightTapped" />

                    <Grid Style="{StaticResource SidebarSection}" ColumnDefinitions="*,Auto">
                        <TextBlock Style="{StaticResource SidebarHeader}" Text="ドライブと場所" />
                        <Button x:Name="DriveToggle" Grid.Column="1" Style="{StaticResource SidebarHeaderButton}" />
                    </Grid>
                    <ListView x:Name="DriveList" Style="{StaticResource SidebarList}" ItemClick="Sidebar_ItemClick" RightTapped="Sidebar_RightTapped" />

                    <!-- 容量の上限（クォータ）があるときだけ表示 -->
                    <Grid x:Name="ZoneHeader" Style="{StaticResource SidebarSection}" ColumnDefinitions="*,Auto" Visibility="Collapsed">
                        <TextBlock Style="{StaticResource SidebarHeader}" Text="容量の上限" />
                        <Button x:Name="ZoneToggle" Grid.Column="1" Style="{StaticResource SidebarHeaderButton}" />
                    </Grid>
                    <ListView x:Name="ZoneList" Style="{StaticResource SidebarList}" ItemClick="Sidebar_ItemClick" />

                    <Expander Header="保存した作業" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Margin="8,16,12,0">
                        <StackPanel Margin="-8,0,-8,0">
                            <Grid Style="{StaticResource SidebarSection}" ColumnDefinitions="*,Auto,Auto">
                                <TextBlock Style="{StaticResource SidebarHeader}" Text="ワークスペース" />
                                <Button Grid.Column="1" Style="{StaticResource SidebarHeaderButton}"
                                        AutomationProperties.Name="現在のタブ構成を保存" ToolTipService.ToolTip="現在のタブ構成を保存" Click="SaveWorkspace_Click">
                                    <FontIcon Glyph="&#xE74E;" FontSize="16" />
                                </Button>
                                <Button x:Name="WorkspaceToggle" Grid.Column="2" Style="{StaticResource SidebarHeaderButton}" />
                            </Grid>
                            <ListView x:Name="WorkspaceList" Style="{StaticResource SidebarList}" ItemClick="Sidebar_ItemClick" RightTapped="Sidebar_RightTapped" />

                            <Grid Style="{StaticResource SidebarSection}" ColumnDefinitions="*,Auto">
                                <TextBlock Style="{StaticResource SidebarHeader}" Text="保存した検索" />
                                <Button x:Name="SavedSearchToggle" Grid.Column="1" Style="{StaticResource SidebarHeaderButton}" />
                            </Grid>
                            <ListView x:Name="SavedSearchList" Style="{StaticResource SidebarList}" ItemClick="Sidebar_ItemClick" RightTapped="Sidebar_RightTapped" />
                        </StackPanel>
                    </Expander>
                </StackPanel>
            </ScrollViewer>

            <!-- 下: 容量・管理・設定（アイコン付きで同じ形に揃える）。読み上げの名前は見えている文字と同じにし、説明はツールチップに出す -->
            <StackPanel Grid.Row="1" Spacing="2" Padding="8,8,12,0"
                        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
                    <Button Style="{StaticResource SidebarFooterButton}" Click="Capacity_Click"
                            AutomationProperties.Name="容量を確認" ToolTipService.ToolTip="容量（フォルダ別の内訳・大きいファイル）">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <FontIcon Glyph="&#xEDA2;" FontSize="18" Foreground="#30A46C" />
                            <TextBlock Text="容量を確認" FontSize="14" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="AdminButton" Style="{StaticResource SidebarFooterButton}" Click="Admin_Click" Visibility="Collapsed"
                            AutomationProperties.Name="ユーザーと権限" ToolTipService.ToolTip="ユーザー・権限・監査ログ（管理者）">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <FontIcon Glyph="&#xE7EF;" FontSize="18" Foreground="#8E4EC6" />
                            <TextBlock Text="ユーザーと権限" FontSize="14" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="2">
                        <Button x:Name="SettingsButton" Style="{StaticResource SidebarFooterButton}" Click="Settings_Click"
                                AutomationProperties.Name="設定" ToolTipService.ToolTip="エクスプローラー置き換え・表示・言語・データ">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <FontIcon Glyph="&#xE713;" FontSize="18" Foreground="#5B6B7F" />
                                <TextBlock Text="設定" FontSize="14" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="1" Style="{StaticResource SidebarFooterButton}" Click="Help_Click" MinWidth="42"
                                AutomationProperties.Name="ヘルプ（ショートカット一覧・使い方の案内）" ToolTipService.ToolTip="ヘルプ（ショートカット一覧・使い方の案内）(F1)">
                            <FontIcon Glyph="&#xE897;" FontSize="18" Foreground="#5B6B7F" />
                        </Button>
                    </Grid>
            </StackPanel>
            </Grid>

            <!-- TabView の既定スタイルは上寄せで内容の高さに縮むため、区画を縦いっぱいに広げる（一覧の仮想化のためにも必要） -->
            <TabView x:Name="Tabs" Grid.Column="1"
                     AddTabButtonClick="Tabs_AddTabButtonClick"
                     TabCloseRequested="Tabs_TabCloseRequested"
                     SelectionChanged="Tabs_SelectionChanged"
                     TabWidthMode="SizeToContent"
                     VerticalAlignment="Stretch"
                     CanReorderTabs="True" />
        </Grid>

        <!-- ステータスバー -->
        <Grid Grid.Row="2" Padding="16,6" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="16" Background="{ThemeResource LayerFillColorAltBrush}"
              BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
            <TextBlock x:Name="StatusText" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            <TextBlock x:Name="AccountText" Grid.Column="1" FontSize="12" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       ToolTipService.ToolTip="Windows のサインインをそのまま使っています（FileBox 独自のログインはありません）" />
            <Button x:Name="IndexStatusButton" Grid.Column="2" Background="Transparent" BorderThickness="0" Padding="6,2" FontSize="12" AutomationProperties.Name="インデックスの状態を確認">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon x:Name="IndexStatusIcon" Glyph="&#xE895;" FontSize="12" />
                    <TextBlock x:Name="IndexStatusText" Text="インデックス: 接続中…" />
                </StackPanel>
                <Button.Flyout>
                    <Flyout>
                        <StackPanel Spacing="8" MaxWidth="380">
                            <TextBlock Text="インデックスの状態" FontWeight="SemiBold" />
                            <TextBlock x:Name="IndexDetailText" TextWrapping="Wrap" FontSize="12" IsTextSelectionEnabled="True" />
                            <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Text="管理者権限で起動すると NTFS の MFT を直接読むため、構築が数秒〜数十秒に短縮され、変更もリアルタイムに反映されます（次回以降はスナップショットから即時起動）。" />
                            <Button x:Name="ElevateButton" Content="管理者として高速インデックス (MFT) に切り替え" Click="Elevate_Click" />
                        </StackPanel>
                    </Flyout>
                </Button.Flyout>
            </Button>
        </Grid>
    </Grid>
</Window>
